<%- include('head', { back: '/discover', page: owner ? 'app' : '' }) %>
<% if (preview) { %><div class="pvb">Preview. Only you can see this page until you make it live. <a href="/publish">Go live</a></div><% } %>
<section class="pp">
  <% if (owner) { %><a class="editpen" href="/dashboard/profile" aria-label="Edit profile"><svg class="i"><use href="#i-edit"/></svg></a><% } %>
  <div class="ppt">
    <h1><%= name %><% if (verified) { %><svg class="vb big4" aria-label="Verified"><use href="#i-seal"/></svg><% } %></h1>
    <p class="tag"><% if (p.tier >= 2 && p.category_label) { %><%= p.category_label %><% } %><% if (p.tier >= 2 && p.category_label && place) { %> <em>&amp;</em> <% } %><%= place %></p>
    <p class="handle">@<%= p.username %></p>
    <% if (bio) { %><p class="txt"><%= bio %></p><% } %>
    <% if (p.tier === 3 && p.links && p.links.length) { %><div class="links"><% p.links.forEach(function (l) { %><a class="lk" rel="nofollow ugc noopener" target="_blank" href="<%= l %>"><%= new URL(l).hostname.replace(/^www\./, '') %></a><% }) %></div><% } %>
  </div>
  <div class="pph">
    <% if (photoShown) { %><img class="ph <%= verified ? 'vr' : '' %>" src="/photo/<%= p.username %>" alt="<%= name %>"><% } else { %><div class="ph blank <%= verified ? 'vr' : '' %>" aria-hidden="true"><%= name.replace('@', '').charAt(0).toUpperCase() %></div><% } %>
    <% if (verified) { %><div class="vpill"><svg class="vb2"><use href="#i-seal"/></svg>Verified<% if (vdate) { %> | <%= new Date(vdate).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) %><% } %></div><% } %>
    <ul class="facts">
      <% if (age) { %><li><b><%= age %></b><span>Age</span></li><% } %>
      <% if (since) { %><li><b><%= since %></b><span>Member since</span></li><% } %>
    </ul>
  </div>
</section>
<% if (ach.length) { %><section class="ps"><h2>Achievements</h2><ul class="ach"><% ach.forEach(function (a) { %><li><svg class="i"><use href="#i-check"/></svg><%= a %></li><% }) %></ul></section><% } %>
<% if (p.tier === 3 && p.bio_long) { %><section class="ps"><h2>Professional biography</h2><p class="biol"><%= p.bio_long %></p></section><% } %>
<% if (p.tier === 3 && p.show_contact && (p.public_email || p.contact_address)) { %><section class="ps"><h2>Contact</h2><div class="contact"><% if (p.public_email) { %><a href="mailto:<%= p.public_email %>"><%= p.public_email %></a><% } %><% if (p.contact_address) { %><span><%= p.contact_address %></span><% } %></div></section><% } %>
<%- include('foot') %>
