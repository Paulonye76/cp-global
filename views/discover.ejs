<%- include('head', { title: 'Discover people | CP Global', desc: 'Find people on CP Global by name, username, profession or location.', canonical: base + '/discover', page: user ? 'app' : 'info', back: user ? '/dashboard' : '/', strict: !!user }) %>
<% var feat = searching ? [] : list.filter(function (x) { return x.featured; }); var rest = searching ? list : list.filter(function (x) { return !x.featured; }); %>
<section class="disc">
  <h1>Discover <span class="g">people.</span></h1>
  <p class="lead">Search by name, username, profession or location.</p>
  <form class="dsearch" method="get" action="/discover">
    <div class="field big"><svg class="i"><use href="#i-search"/></svg><input name="q" value="<%= q %>" placeholder="Name, username or profession" aria-label="Search"></div>
    <div class="frow">
      <select name="cat" aria-label="Profession"><option value="">Any profession</option><% CATS.forEach(function (c) { %><option <%= cat === c ? 'selected' : '' %>><%= c %></option><% }) %></select>
      <input name="loc" value="<%= loc %>" placeholder="City or country" aria-label="Location">
      <button class="btn">Search</button>
    </div>
  </form>
  <% if (feat.length) { %><h2 class="dh">Featured profiles</h2><div class="pgrid"><% feat.forEach(function (x) { %><%- include('pcard', { x: x }) %><% }) %></div><% } %>
  <h2 class="dh"><%= searching ? 'Results' : 'Popular profiles' %></h2>
  <% if (!rest.length && !feat.length) { %>
    <div class="card2 empty"><h3><%= searching ? 'No one matches that yet.' : 'No live profiles yet.' %></h3><p class="hint">Be the first to be found.</p><a class="btn" href="/register">Start for free</a></div>
  <% } else if (rest.length) { %>
    <div class="pgrid"><% rest.forEach(function (x) { %><%- include('pcard', { x: x }) %><% }) %></div>
  <% } %>
</section>
<%- include('foot') %>
