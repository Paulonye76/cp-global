<%- include('head', { title: 'Welcome | CP Global', noindex: true }) %>
<div class="onb" data-onb data-s="<%= err ? 'chat' : 'splash' %>" data-start="<%= start %>">
  <div class="stage s-splash">
    <div class="ic">cp</div>
    <div class="wm" aria-label="CP Global"><% 'CP Global'.split('').forEach(function (c, k) { %><span style="--i:<%= k %>"><%= c === ' ' ? '\u00a0' : c %></span><% }) %></div>
  </div>

  <div class="stage s-welcome">
    <div class="art">
      <i class="orb o1"></i><i class="orb o2"></i>
      <div class="fc f1"><svg class="av" style="--a1:#d9f5e1;--a2:#0b6b2c"><use href="#av"/></svg><div><b>@amaka.ade</b><small>Nigeria</small></div><svg class="i"><use href="#i-shield"/></svg></div>
      <div class="fc f2"><svg class="av" style="--a1:#e8e8ed;--a2:#1d1d1f"><use href="#av"/></svg><div><b>@tunde</b><small>Creator</small></div><svg class="i"><use href="#i-shield"/></svg></div>
      <div class="fc f3"><svg class="av" style="--a1:#fde9d9;--a2:#7a3b12"><use href="#av"/></svg><div><b>@ngozi_k</b><small>Artist</small></div><svg class="i"><use href="#i-shield"/></svg></div>
    </div>
    <div class="wl">CP Global</div>
    <h1>It’s time to be <span class="g">found first.</span></h1>
    <a class="am" href="/login">I’m already a member</a>
    <span class="rl">I’m ready</span>
    <button class="rd" type="button" data-ready aria-label="I’m ready"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </div>

  <div class="stage s-chat">
    <div class="pbar"><i></i></div>
    <% if (err) { %><p class="aerr onbe"><%= err %></p><% } %>
    <button class="bk" type="button" data-back aria-label="Back"><svg class="i" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
    <form method="post" action="/welcome" enctype="multipart/form-data" class="qwrap">
      <input type="hidden" name="csrf" value="<%= csrf %>">

      <div class="qs" data-auto><div class="me">cp</div><h2 class="q">Hi <%= p.full_name.split(' ')[0] %>, let’s get started. Which best describes you?</h2>
        <div class="ans"><% CATS.forEach(function (c) { %><label><input type="radio" name="category" value="<%= c %>"><span><%= c %></span></label><% }) %><div class="other-box" hidden><input class="pin" name="category_other" maxlength="40" placeholder="Tell us what you do"><button type="button" class="pill go" data-other-next>Continue</button></div></div></div>

      <div class="qs" data-auto><div class="me">cp</div><h2 class="q">What brings you here?</h2>
        <div class="ans"><% GOALS.forEach(function (c) { %><label><input type="radio" name="goal" value="<%= c %>"><span><%= c %></span></label><% }) %></div></div>

      <div class="qs" data-auto><div class="me">cp</div><h2 class="q">How did you hear about us?</h2>
        <div class="ans"><% SOURCES.forEach(function (c) { %><label><input type="radio" name="source" value="<%= c %>"><span><%= c %></span></label><% }) %></div></div>

      <div class="qs" data-v="dob"><div class="me">cp</div><h2 class="q">When’s your birthday?</h2>
        <div class="ans"><input class="pin" type="date" name="dob" aria-label="Date of birth" required max="<%= new Date().toISOString().slice(0, 10) %>"><p class="agev" data-agev></p><button type="button" class="pill go" data-next>Continue</button></div></div>

      <div class="qs" data-auto><div class="me">cp</div><h2 class="q">Want your age shown on your page?</h2>
        <div class="ans"><label><input type="radio" name="show_age" value="on"><span>Yes, show it</span></label><label><input type="radio" name="show_age" value="off"><span>No, keep it private</span></label></div></div>

      <div class="qs" data-v="country"><div class="me">cp</div><h2 class="q">Where are you based?</h2>
        <div class="ans"><input class="pin" name="country" maxlength="56" required placeholder="Country (required)" value="<%= p.country || '' %>"><input class="pin" name="city" maxlength="60" placeholder="City"><button type="button" class="pill go" data-next>Continue</button></div></div>

      <div class="qs"><div class="me">cp</div><h2 class="q">Add a clear photo of your face.</h2>
        <div class="ans"><label class="pill go">Choose a photo<input type="file" name="photo" accept="image/jpeg,image/png,image/webp" hidden data-photo></label><button type="button" class="pill" data-next>Skip for now</button></div></div>

      <div class="qs"><div class="me">cp</div><h2 class="q">You’re all set, <%= p.full_name.split(' ')[0] %>. Next, let’s make you live on Google.</h2>
        <div class="ans"><button class="pill go">Take me to my dashboard</button></div></div>
    </form>
    <p class="nt">We use this to personalize your page. Your birthday is never shown unless you switch it on.</p>
  </div>
</div>
<%- include('foot') %>
