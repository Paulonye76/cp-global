<%- include('head', { title: 'Dashboard | CP Global', noindex: true, page: 'app' }) %>
<% var items = [['Full name', !!p.full_name], ['Country', !!p.country], ['Date of birth', !!p.dob], ['What you do', !!p.category], ['Photo', p.has_photo]];
   var pct = Math.round(items.filter(function (x) { return x[1]; }).length / items.length * 100);
   var paused = !live && p.trial_used;
   var url = base + '/' + p.username;
   var title = '@' + p.username + (p.show_name ? ' | ' + p.full_name : '') + ' | CP Global';
   var vs = p.verify_status || 'none'; %>
<section class="dash">
  <div class="hello"><h1>Hi, <%= p.full_name.split(' ')[0] %></h1><p>Manage your page and how Google sees you.</p></div>
  <% if (msg) { %><p class="ok"><%= msg %></p><% } %>

  <div class="hero2 <%= live ? 'live' : '' %>">
    <div class="ringp" style="--p:<%= pct %>"><b><%= pct %>%</b><span>complete</span></div>
    <div class="h2c">
      <% if (live) { %><h2>You are live on Google</h2><p><%= daysLeft !== null ? 'Free trial ends in ' + daysLeft + ' day' + (daysLeft === 1 ? '' : 's') + '.' : 'Your page is public.' %></p>
        <a class="btn" href="/<%= p.username %>">View my page</a> <a class="btn alt" href="/publish">Change plan</a>
      <% } else if (paused) { %><h2>Your page is paused</h2><p>Choose a plan to go live again.</p><a class="btn" href="/publish">Choose a plan</a>
      <% } else { %><h2>Make your profile live on Google</h2><p>Choose a plan, check your details and publish. Your first 3 days are free.</p><a class="btn shine" href="/publish">Make it live</a><% } %>
    </div>
  </div>

  <div class="card2 vcard <%= vs %>">
    <svg class="vb big3"><use href="#i-seal"/></svg>
    <div>
      <% if (vs === 'verified') { %><h3>You are verified</h3><p class="hint">Your profile shows the CP Global verified badge.</p>
      <% } else if (vs === 'pending') { %><h3>Verification under review</h3><p class="hint">We will message you in Notifications when it is done.</p>
      <% } else if (!p.has_photo) { %><h3>Add a photo to get verified</h3><p class="hint">Your photo stays off Google until you are verified.</p><a class="btn alt small" href="/dashboard/profile">Add a photo</a>
      <% } else { %><h3>Get your verified badge</h3><p class="hint">Two quick selfies. Your photo can then show on Google.</p><a class="btn small" href="/verify">Verify now</a><% } %>
    </div>
  </div>

  <div class="g2">
    <div class="card2 pc">
      <% if (p.has_photo) { %><img class="avatar big2" src="/photo/<%= p.username %>" alt="Your photo"><% } else { %><svg class="av big2" style="--a1:#d9f5e1;--a2:#0b6b2c"><use href="#av"/></svg><% } %>
      <div><h3><%= p.full_name %><% if (vs === 'verified') { %><svg class="vb"><use href="#i-seal"/></svg><% } %></h3><p class="hint">@<%= p.username %><%= p.category ? ' | ' + p.category : '' %></p>
        <a class="btn alt small" href="/dashboard/profile"><svg class="i"><use href="#i-edit"/></svg> Edit profile</a></div>
    </div>
    <div class="card2">
      <h3>Google visibility</h3>
      <p class="vis <%= live ? 'ok1' : '' %>"><%= live ? 'Your page is public and ready for Google.' : 'Your page is not public, so Google cannot show it.' %></p>
      <div class="serp2"><small><%= url.replace(/^https?:\/\//, '') %></small><b><%= title %></b><p><%= (p.tier >= 2 && p.bio) ? p.bio : p.full_name + ' on CP Global. Find @' + p.username + ' first.' %></p></div>
      <a class="btn alt small" target="_blank" rel="noopener" href="https://www.google.com/search?q=<%= encodeURIComponent('@' + p.username) %>">Search it on Google</a>
      <p class="hint">Google finds new pages through our sitemap. This can take a few days.</p>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><svg class="i"><use href="#i-eye"/></svg><b><%= p.views || 0 %></b><span>Page views</span></div>
    <div class="stat"><svg class="i"><use href="#i-share"/></svg><b><%= p.shares || 0 %></b><span>Shares</span></div>
    <div class="stat"><svg class="i"><use href="#i-shield"/></svg><b>Tier <%= p.tier || 1 %></b><span>Your plan</span></div>
  </div>

  <div class="card2"><h3>Quick actions</h3>
    <div class="qa">
      <a href="/dashboard/profile"><svg class="i"><use href="#i-edit"/></svg>Edit profile</a>
      <button type="button" data-share data-url="<%= url %>" data-title="<%= title %>" data-csrf="<%= csrf %>"><svg class="i"><use href="#i-share"/></svg><span>Share page</span></button>
      <a href="/dashboard/qr"><svg class="i"><use href="#i-qr"/></svg>QR code</a>
      <a href="/publish"><svg class="i"><use href="#i-shield"/></svg>Change plan</a>
      <a href="/discover"><svg class="i"><use href="#i-compass"/></svg>Discover</a>
      <a href="/<%= p.username %>"><svg class="i"><use href="#i-eye"/></svg>My page</a>
    </div>
  </div>

  <div class="card2"><h3>Your checklist</h3>
    <ul class="cl"><% items.forEach(function (x) { %><li class="<%= x[1] ? 'ok1' : '' %>"><svg class="i"><use href="#i-check"/></svg><%= x[0] %></li><% }) %></ul>
    <% if (pct < 100) { %><a class="btn alt small" href="/dashboard/profile">Complete my profile</a><% } %></div>
</section>
<%- include('foot') %>
