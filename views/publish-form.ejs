<%- include('head', { title: 'Tier ' + tier + ' | CP Global', noindex: true, page: 'app', back: '/publish/plans', strict: true }) %>
<% var T = ['', 'Identity', 'Short intro', 'Full profile'][tier]; var cap = tier === 1 ? 20 : 150; var blocked = tier > 1 && !open; %>
<section class="dash">
  <div class="hello"><h1>Tier <%= tier %> <span class="g"><%= T %></span></h1><p>Check your details, then <%= blocked ? 'save them' : 'publish' %>.</p></div>
  <% if (msg) { %><p class="ok"><%= msg %></p><% } %>
  <% if (err) { %><p class="err"><%= err %></p><% } %>
  <form method="post" action="/publish/<%= tier %>" class="sws">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <div class="card2 form"><div class="sh"><svg class="i"><use href="#i-user"/></svg><div><h3>Your details</h3><p>Who you are on Google.</p></div></div>
      <label>Full name<input name="full_name" maxlength="60" required value="<%= p.full_name %>"></label>
      <label class="check"><input type="checkbox" name="show_name" <%= p.show_name ? 'checked' : '' %>> Show my name on Google</label>
      <label>Country<input name="country" maxlength="56" required value="<%= p.country || '' %>"></label>
      <label class="check"><input type="checkbox" name="show_country" <%= p.show_country ? 'checked' : '' %>> Show my country on Google</label>
      <label>What you do<select name="category" data-cat><% CATS.forEach(function (c) { %><option <%= p.category === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label data-other hidden>Tell us what you do<input name="category_other" maxlength="40" value="<%= p.category_other || '' %>"></label>
      <% if (p.dob) { %><label class="check"><input type="checkbox" name="show_age" <%= p.show_age ? 'checked' : '' %>> Show my age on Google</label><% } %>
      <label class="check"><input type="checkbox" name="show_photo" <%= p.show_photo ? 'checked' : '' %>> Show my photo on Google (<%= p.verify_status === 'verified' ? 'verified' : 'needs verification' %>)</label>
    </div>

    <div class="card2 form"><div class="sh"><svg class="i"><use href="#i-edit"/></svg><div><h3><%= tier === 1 ? 'Short bio' : 'Bio' %></h3><p><%= cap %> characters. No links.</p></div></div>
      <label>Bio<textarea name="bio" maxlength="<%= cap %>" rows="<%= tier === 1 ? 2 : 3 %>" placeholder="Who you are"><%= (p.bio || '').slice(0, cap) %></textarea></label>
    </div>

    <% if (tier === 3) { %>
    <div class="card2 form"><div class="sh"><svg class="i"><use href="#i-share"/></svg><div><h3>Full profile</h3><p>Your story, links and contact.</p></div></div>
      <label>Professional biography<textarea name="bio_long" maxlength="1000" rows="6"><%= p.bio_long || '' %></textarea></label>
      <label>Achievements (one per line, up to 6)<textarea name="achievements" maxlength="700" rows="4"><%= p.achievements || '' %></textarea></label>
      <% for (var k = 0; k < 3; k++) { %><label>Link <%= k + 1 %><input name="link<%= k + 1 %>" type="url" maxlength="200" placeholder="https://" value="<%= (p.links && p.links[k]) || '' %>"></label><% } %>
      <label>Public email<input type="email" name="public_email" maxlength="120" value="<%= p.public_email || '' %>"></label>
      <label>Contact address<input name="contact_address" maxlength="200" value="<%= p.contact_address || '' %>"></label>
      <label class="check"><input type="checkbox" name="show_contact" <%= p.show_contact ? 'checked' : '' %>> Show email and address on my page</label>
    </div>
    <% } %>

    <% if (blocked) { %><p class="hint">Paid plans open soon. You can save these details now. Tier 1 can go live free today.</p><% } %>
    <div class="pbar2"><div><small>Plan</small><b>Tier <%= tier %></b></div><button class="btn"><%= blocked ? 'Save details' : 'Publish my profile' %></button></div>
  </form>
</section>
<%- include('foot') %>
