<%- include('head', { title: 'Go live | CP Global', noindex: true, page: 'app', back: '/dashboard', strict: true }) %>
<% var TIERS = [
  ['1', 'Tier 1', 'Identity', 'Free for 3 days', ['Photo and name', 'Country and optional age', '20-character bio', 'Public or hidden switches', 'QR card']],
  ['2', 'Tier 2', 'Short intro', open ? 'Free preview' : 'Coming soon', ['Everything in Tier 1', '150-character bio', 'Profession tag']],
  ['3', 'Tier 3', 'Full profile', open ? 'Free preview' : 'Coming soon', ['Everything in Tier 2', '1000-character bio', 'Achievements and links', 'Email and contact']]
]; %>
<section class="dash">
  <% if (msg) { %><p class="ok"><%= msg %></p><% } %>
  <% if (live && !plans) { %>
    <div class="card2 vdone livec">
      <div class="liveic"><svg class="i"><use href="#i-check"/></svg></div>
      <h2>Your profile is live</h2>
      <p class="hint">@<%= p.username %> is public on Google. Google can take a few days to show it.</p>
      <a class="btn big" href="/<%= p.username %>">View profile</a>
      <a class="btn ghost big" href="/publish/plans">Change plan</a>
      <form method="post" action="/profile/offline"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="btn ghost big">Take it offline</button></form>
    </div>
  <% } else if (p.unpublished && !plans) { %>
    <div class="card2 vdone livec">
      <h2>Your profile is hidden</h2>
      <p class="hint">It is not on Google right now. You can turn it back on any time.</p>
      <form method="post" action="/profile/online"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="btn big">Make it live again</button></form>
      <a class="btn ghost big" href="/publish/plans">Change plan</a>
    </div>
  <% } else { %>
    <div class="hello"><h1>Make your profile <span class="g">live</span></h1><p>Choose a plan. Each plan has its own page.</p></div>
    <div class="tcs">
      <% TIERS.forEach(function (t) { %>
      <div class="tcb plc"><% if (t[0] === '3') { %><span class="rib">Most complete</span><% } %>
        <span class="tt"><b><%= t[1] %></b></span>
        <em><%= t[2] %></em><strong class="pr"><%= t[3] %></strong>
        <ul><% t[4].forEach(function (f) { %><li><svg class="i"><use href="#i-check"/></svg><%= f %></li><% }) %></ul>
        <a class="btn big" href="/publish/<%= t[0] %>">Choose <%= t[1] %></a>
      </div>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('foot') %>
