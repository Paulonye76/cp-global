<%- include('head', { title: 'Review verifications | CP Global', noindex: true, page: 'app', back: '/dashboard', strict: true }) %>
<section class="dash">
  <div class="hello"><h1>Verification requests</h1><p>Compare the selfies with the profile photo.</p></div>
  <%- include('admin-nav', { tab: 'v' }) %>
  <% if (!list.length) { %><div class="card2 empty"><h3>No pending requests</h3></div><% } %>
  <% list.forEach(function (x) { %>
  <div class="card2">
    <h3>@<%= x.username %> <small class="hint"><%= x.full_name %></small></h3>
    <p class="hint">Asked to: <%= ({ left: 'turn head to their left', right: 'turn head to their right', smile: 'smile' })[x.verify_prompt] || x.verify_prompt || 'none' %></p>
    <div class="shots three"><img src="/admin/verify/img/<%= x.user_id %>/photo" alt="Profile photo"><img src="/admin/verify/img/<%= x.user_id %>/1" alt="Selfie 1"><img src="/admin/verify/img/<%= x.user_id %>/2" alt="Selfie 2"></div>
    <form method="post" action="/admin/verify/<%= x.user_id %>" class="form">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <input name="note" maxlength="140" placeholder="Reason if rejecting (optional)">
      <div class="qa two"><button name="action" value="approve" class="btn">Approve</button><button name="action" value="reject" class="btn alt">Reject</button></div>
    </form>
  </div>
  <% }) %>
</section>
<%- include('foot') %>
